format = gauntpy-synthetic-maze-v1
name = pathological-projectile-channels
description = Four heroes, demons, and lobbers start with all shot channels occupied.
frames = 600
level = 16
seed = 0
character = elf
health = 20000
input = idle

[events]
0 input p1 right+fire
0 input p2 down+fire
0 input p3 left+fire
0 input p4 up+fire
120 input p1 up-right+fire
120 input p2 down-right+fire
120 input p3 down-left+fire
120 input p4 up-left+fire
300 input p1 idle
300 input p2 idle
300 input p3 idle
300 input p4 idle

