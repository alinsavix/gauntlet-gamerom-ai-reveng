format = gauntpy-synthetic-maze-v1
name = benchmark-empty
description = Open arena with deterministic movement and action playback.
frames = 600
level = 16
seed = 0
character = elf
health = 20000
input = idle

[events]
0 input right+fire
60 input down+fire
120 input left
180 input up+magic
184 input up
240 input left+fire
300 input down
360 input right+fire
420 input up-right
480 input idle+fire
484 input idle

