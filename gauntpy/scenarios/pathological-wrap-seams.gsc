format = gauntpy-synthetic-maze-v1
name = pathological-wrap-seams
description = Actors and projectiles crowd both enabled maze-wrap seams.
frames = 900
level = 16
flags = 0x00000030
seed = 0
character = elf
health = 20000
input = idle

[events]
0 input left+fire
120 input up+fire
240 input up-left+fire
360 input right+fire
480 input down+fire
600 input down-right+fire
720 input idle

