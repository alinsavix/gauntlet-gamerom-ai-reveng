format = gauntpy-synthetic-maze-v1
name = benchmark-mobs
description = Dense mix of all ordinary monster families.
frames = 600
level = 16
seed = 0
character = elf
health = 20000
input = idle

[events]
0 input right+fire
75 input down+fire
150 input left+fire
225 input up+fire
300 input down-right+fire
375 input up-left+fire
450 input fire
510 input idle

