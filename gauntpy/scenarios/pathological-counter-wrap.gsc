format = gauntpy-synthetic-maze-v1
name = pathological-counter-wrap
description = Input events straddle frame counter 0xFFFF to 0x0000.
frames = 64
level = 16
seed = 0
character = elf
health = 20000
input = idle

[events]
65520 input right+fire
65528 input up+fire
65535 input idle+magic
0 input left+fire
8 input down+fire
16 input down-right+fire
32 input idle

